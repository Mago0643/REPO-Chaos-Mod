<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
	  <!-- nvm -->
    <Nullable>enable</Nullable>
    <Authors>Lego0_77</Authors>
    <Version>1.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableGameReferences>true</EnableGameReferences>
	  
    <!--==================================================-->
    <!--=                                                =-->
    <!--= IMPORTANT: Change this to your REPO directory. =-->
    <!--=                                                =-->
    <!--==================================================-->
    <GameDirectory>E:\SteamLibrary\steamapps\common\REPO\</GameDirectory>

    <GaleProfileName>Default</GaleProfileName>
  </PropertyGroup>

  <!-- Add Package Sources -->
  <PropertyGroup>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.windows10ce.com/nuget/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!-- Package References -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" IncludeAssets="build" />
    <PackageReference Include="Linkoid.Repo.Common.Build" Version="*" PrivateAssets="all" />
    <PackageReference Include="Linkoid.Repo.Plugin.Build" Version="*" PrivateAssets="all" />
    <!--<PackageReference Include="R.E.P.O.GameLibs.Steam" Version="*-*" PrivateAssets="all" Publicize="true" />-->
    <PackageReference Include="REPOModding-MenuLib" Version="2.*" />

    <PackageReference Include="Krafs.Publicizer" Version="2.*" PrivateAssets="all" />
    <Reference Include="Assembly-CSharp" HintPath="${GameDirectory}/REPO_Data/Managed/Assembly-CSharp.dll" Publicize="true" />
    
    <PackageReference Include="BepInEx.Core" Version="5.*" ExcludeAssets="runtime" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.3.17" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Zehs.REPOLib" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <None Update="assets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="car_assets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="en-us.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ko.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
